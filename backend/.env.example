POSTGRES_DB=focus_day
POSTGRES_USER=focus_day
POSTGRES_PASSWORD=replace-with-a-long-database-password

DATABASE_URL=postgresql+asyncpg://focus_day:replace-with-a-long-database-password@db:5432/focus_day
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://..../auth/google/callback
SECRET_KEY=replace-with-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=30
# Set to true when the site is served over HTTPS
COOKIE_SECURE=false
# Fernet key for integration credentials (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())").
# If empty, a key is derived from SECRET_KEY — changing SECRET_KEY then invalidates saved credentials.
INTEGRATIONS_ENCRYPTION_KEY=
DEFAULT_TIMEZONE=Europe/Moscow
# Shared secret between the backend and the Telegram bot (same value in tg_bot/.env)
BOT_API_TOKEN=replace-with-a-random-secret
# Bot username without @, used for the t.me deep link
TELEGRAM_BOT_USERNAME=
STORAGE_PATH=/app/storage
MAX_FILE_SIZE_MB=20
SBER_AUTHORIZATION_KEY=
SBER_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat