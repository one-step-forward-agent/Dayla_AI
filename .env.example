# Overrides for docker-compose.yml / docker-compose.prod.yml (copy to .env next to it).
# Production: POSTGRES_PASSWORD and BOT_API_TOKEN are required (see DEPLOY.md).
DOMAIN=dayla.stxddd.ru
# Service settings live in backend/.env and tg_bot/.env.
POSTGRES_DB=focus_day
POSTGRES_USER=focus_day
POSTGRES_PASSWORD=change-me
# Shared secret between backend and bot; compose passes it to both services
BOT_API_TOKEN=change-me
