# Rendered by the nginx image entrypoint (envsubst) into /etc/nginx/conf.d/default.conf.
# BACKEND_URL: where the backend listens, e.g. http://app:8000 under compose or the Amvera internal address.
server {
    listen 80;
    root /usr/share/nginx/html;
    server_tokens off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # API and auth go to the backend on the same origin, so its httpOnly cookies apply.
    location ~ ^/(api|auth|health)(/|$) {
        proxy_pass ${BACKEND_URL};
        # $proxy_host keeps routing working when BACKEND_URL is a public HTTPS domain behind an ingress.
        proxy_set_header Host $proxy_host;
        # $http_host keeps the port (localhost:3000); the backend compares it with the Origin header.
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_server_name on;
        proxy_read_timeout 120s;
        client_max_body_size 25m;
    }

    location / {
        try_files $uri /index.html;
    }
}
