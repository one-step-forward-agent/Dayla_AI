TOKEN=telegram-bot-token-from-botfather

# Ignored under docker compose (it points the bot at the shared database)
DATABASE_URL=postgresql+asyncpg://focus_day:password@127.0.0.1:5432/focus_day

SBER_AUTHORIZATION_KEY=
SBER_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat

# Focus Day backend; set automatically under docker compose
BACKEND_URL=http://127.0.0.1:8000
BOT_API_TOKEN=same-value-as-backend
NOTIFICATION_POLL_SECONDS=20
